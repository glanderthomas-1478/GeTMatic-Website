# Kompletter Sperrblock fuer diesen Ordner: alle abgelegten Dateien duerfen
# ausschliesslich ueber download.php (mit Login-Pruefung) ausgeliefert werden,
# niemals per direktem HTTP-Zugriff auf die Datei selbst.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 Fallback
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
# php_flag gibt es nur mit mod_php, sonst fuehrt die Zeile zu HTTP 500
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
AddType text/plain .php .php3 .php4 .php5 .phtml .pl .cgi .sh
