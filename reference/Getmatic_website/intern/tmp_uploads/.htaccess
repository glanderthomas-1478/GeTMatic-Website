# Gleicher Schutz wie files/.htaccess: hier liegen die noch nicht
# fertiggestellten Chunk-Upload-Assembly-Dateien. Niemals direkt erreichbar.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes -ExecCGI
# php_flag gibt es nur mit mod_php, sonst fuehrt die Zeile zu HTTP 500
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
AddType text/plain .php .php3 .php4 .php5 .phtml .pl .cgi .sh
