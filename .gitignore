.DS_Store
__pycache__/
*.pyc
*.log
*.tmp
*.bak
.claude/settings.local.json

# Interner Mitarbeiterbereich (Login/Datei-Upload) — echte Zugangsdaten und
# hochgeladene/temporaere Nutzerdateien duerfen nie ins Repo gelangen
reference/Getmatic_website/intern/config.php
reference/Getmatic_website/intern/files/*
!reference/Getmatic_website/intern/files/.htaccess
reference/Getmatic_website/intern/tmp_uploads/*
!reference/Getmatic_website/intern/tmp_uploads/.htaccess
reference/Getmatic_website/intern/sql/add_user.php
reference/Getmatic_website/intern/add_user.php

# Sicherheitsnetz: intern/config.php und add_user.php duerfen an KEINER Stelle
# im Repo landen (z.B. falls ein Sync-Tool intern/ irgendwohin spiegelt, siehe
# Warnhinweis "Ungeklaerte Datei-Synchronisation" in context/current-data.md)
**/intern/config.php
**/intern/add_user.php
**/intern/sql/add_user.php

# Video-Rohmaterial und Zwischenstaende der Videobearbeitung (mehrere GB,
# gehoert nicht ins Git-Repo) — fertige, web-optimierte Videos fuer die
# Website liegen stattdessen direkt in reference/Getmatic_website/
reference/Video/

# Sync-Tool-Anomalien (siehe "Ungeklaerte Datei-Synchronisation" in
# context/current-data.md) — bewusst nicht versioniert
Backup_Website/
